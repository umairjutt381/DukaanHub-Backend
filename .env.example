ENVIRONMENT=development
SECRET_KEY=replace-with-a-random-value-at-least-32-characters-long
DATABASE_URL=sqlite:///./dukaanhub.db

FRONTEND_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8001/api/v1/auth/google/callback

ADMIN_EMAIL=admin@dukaanhub.com
ADMIN_PASSWORD=replace-before-production
ADMIN_FULL_NAME=DukaanHub Owner

EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=DukaanHub
EMAIL_ADMIN_RECIPIENT=

PAYMENT_METHOD_CASH_ON_DELIVERY_ENABLED=true
PAYMENT_METHOD_JAZZCASH_ENABLED=false
PAYMENT_METHOD_EASYPAISA_ENABLED=false
PAYMENT_METHOD_CARD_ENABLED=false
PAYMENT_METHOD_STRIPE_ENABLED=false
